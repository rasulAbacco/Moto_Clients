// This is your Prisma schema file,
//  Moto_clients 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 👤 CONSUMER / USER MANAGEMENT
// ==========================================

model User {
  id         String   @id @default(uuid())
  email      String?  @unique // optional — app users sign up with phone OTP
  username   String?  @unique
  password   String?
  role       Role     @default(BUYER)
  fullName   String?
  lastName   String?
  phone      String?  @unique
  avatar     String?
  // Motor Konnect app profile (restored — removed on 2026-10-12 but the app uses them)
  dob              String?
  profileImage     Bytes?
  profileImageType String?
  isVerified Boolean  @default(false)
  isActive   Boolean  @default(true)
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  address      UserAddress?
  vehicles     Vehicle[] // vehicles owned by the user for service bookings
  bookings     Booking[]
  activityLogs ActivityLog[]

  // ---- Marketplace additions ----
  sellerProfile   SellerProfile? // populated only when the user registers as a seller (role = SELLER)
  vehicleListings VehicleListing[] // vehicles this user has listed for sale

  // ---- Field inspection additions ----
  sellerInspections       FieldInspection[]        @relation("SellerInspections")
  inspectorInspections    FieldInspection[]        @relation("InspectorInspections")
  assignedInspections     FieldInspection[]        @relation("AdminAssignedInspections")
  inspectionNotifications InspectionNotification[] @relation("InspectionNotifications")
  sellerNotifications     SellerNotification[]     @relation("SellerNotifications")
  buyerNotifications      BuyerNotification[]      @relation("BuyerNotifications")
  wishlist                Wishlist[]               @relation("BuyerWishlist")
  // ---- Buyer Purchase Requests ----
  buyerPurchaseRequests   PurchaseRequest[]        @relation("BuyerPurchaseRequests")
  sellerPurchaseRequests  PurchaseRequest[]        @relation("SellerPurchaseRequests")
}

model UserAddress {
  id         String  @id @default(uuid())
  userId     String  @unique
  street     String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation("BuyerWishlist", fields: [userId], references: [id], onDelete: Cascade)
  vehicleListingId String
  vehicleListing   VehicleListing @relation(fields: [vehicleListingId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([userId, vehicleListingId])
  @@index([userId])
}

// ==========================================
// 📩 OTP VERIFICATION (mobile + email)
// ==========================================

model OTP {
  id        String   @id @default(uuid())
  mobile    String?
  email     String?
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile])
  @@index([email])
}

// ==========================================
// 🏪 SELLER REGISTRATION / BUSINESS PROFILE
// ==========================================

enum SellerType {
  INDIVIDUAL
  DEALER
}

enum SellerVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  UNDER_REVIEW
}

enum DocumentType {
  PAN_CARD
  GST_CERTIFICATE
  SHOP_LOGO
  PROFILE_PHOTO
  RC
  INSURANCE
  POLLUTION
  INVOICE
  SERVICE_BOOK
  OWNERSHIP_PROOF
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  UNDER_REVIEW
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sellerType   SellerType @default(INDIVIDUAL)
  ownerName    String
  businessName String?
  description  String?

  // Location
  address String?
  city    String?
  state   String?
  pincode String?
  country String  @default("India")

  // Legal / compliance
  gstNumber String?
  panNumber String?

  // Business metadata
  yearsInBusiness Int?
  website         String?

  // Bank / payout details
  bankAccountHolder String?
  bankAccountNumber String?
  bankIFSC          String?
  bankName          String?

  // Branding
  profilePhoto String?
  shopLogo     String?

  isRegistered Boolean @default(true)
  isApproved   Boolean @default(false)

  verificationStatus SellerVerificationStatus @default(PENDING)
  rejectReason       String?
  submittedAt        DateTime                 @default(now())
  reviewedAt         DateTime?
  reviewedBy         String? // admin User.id who approved/rejected

  isElite      Boolean @default(false)
  rating       Float   @default(0)
  totalReviews Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents SellerDocument[]

  @@index([verificationStatus])
}

model SellerNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("SellerNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("GENERAL") // SELLER_STATUS | VEHICLE_APPROVED | VEHICLE_REJECTED | VEHICLE_SOLD | INQUIRY | GENERAL
  link      String? // optional frontend route to deep-link to
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model BuyerNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("BuyerNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("GENERAL")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model SellerDocument {
  id              String         @id @default(cuid())
  sellerProfileId String
  sellerProfile   SellerProfile  @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  type            DocumentType
  fileUrl         String
  status          DocumentStatus @default(PENDING)
  uploadedAt      DateTime       @default(now())
  verifiedAt      DateTime?
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "vehicle.approved", "seller.rejected", "order.completed"
  entityType String? // e.g. "Vehicle", "SellerProfile", "Order"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// ==========================================
// 🚗 VEHICLE MODEL SPECIFICATIONS (service-booking catalog — unchanged)
// ==========================================

model VehicleType {
  id       String    @id @default(uuid())
  name     String    @unique // Enforces strict unique naming: 'CAR', 'BIKE', 'WASHING'
  brands   Brand[]
  vehicles Vehicle[]
  services Service[]
}

model Brand {
  id            String      @id @default(uuid())
  name          String      @unique
  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  models        Model[]
  vehicles      Vehicle[]
}

model Model {
  id        String         @id @default(uuid())
  name      String
  brandId   String
  segment   VehicleSegment
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  modelYear ModelYear[]
}

model ModelYear {
  id           String    @id @default(uuid())
  modelId      String
  year         Int
  heroUrl      String?
  thumbnailUrl String?
  model        Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]

  @@unique([modelId, year])
}

model Vehicle {
  id            String      @id @default(uuid())
  userId        String
  vehicleTypeId String
  brandId       String
  modelId       String
  modelYearId   String?
  registration  String?
  fuelType      String?
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])
  brand         Brand       @relation(fields: [brandId], references: [id])
  model         Model       @relation(fields: [modelId], references: [id])
  modelYear     ModelYear?  @relation(fields: [modelYearId], references: [id])
  bookings      Booking[]

  @@index([userId])
  @@index([vehicleTypeId])
}

// ==========================================
// 🚙 VEHICLE LISTINGS (marketplace "Add Vehicle" form)
// ==========================================

enum VehicleListingStatus {
  DRAFT
  PENDING
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  SOLD
  ARCHIVED
}

model VehicleListing {
  id   String  @id @default(uuid())
  slug String? @unique

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // ---- Basic Information ----
  title              String
  category           String
  brand              String
  model              String
  variant            String?
  registrationNumber String?
  vin                String?

  // ---- Pricing ----
  price        Float
  negotiable   Boolean @default(false)
  emiAvailable Boolean @default(false)

  // ---- Vehicle Details ----
  manufacturingYear Int?
  registrationYear  Int?
  fuelType          String
  transmission      String
  kmDriven          Int?
  ownership         String?
  color             String?
  seatingCapacity   Int?
  engineCapacity    Int?
  mileage           Float?

  // ---- Documents ----
  rcAvailable          Boolean   @default(true)
  insuranceAvailable   Boolean   @default(true)
  insuranceExpiry      DateTime?
  pollutionCertificate Boolean   @default(true)
  serviceBook          Boolean   @default(true)
  numberOfKeys         Int       @default(2)
  loanPending          Boolean   @default(false)
  nocAvailable         Boolean   @default(true)

  // ---- Condition ----
  vehicleCondition String?
  accidentHistory  Boolean @default(false)
  floodDamage      Boolean @default(false)
  engineCondition  String  @default("Good")
  tyreCondition    String  @default("Good")
  batteryCondition String  @default("Good")

  // ---- Features ----
  features String[]

  // ---- Seller Info ----
  sellerName   String?
  mobileNumber String?
  email        String?
  sellerType   String  @default("Individual")
  dealerName   String?

  // ---- Location ----
  country String  @default("India")
  state   String?
  city    String?
  area    String?
  pincode String?

  // ---- Media ----
  images            String[]
  rcFront           String?
  insuranceDocument String?
  documents         String[]

  description String?

  // ---- Status / approval workflow ----
  status     VehicleListingStatus @default(PENDING)
  isFeatured Boolean              @default(false)
  views      Int                  @default(0)

  // ---- Rejection ----
  rejectReason String?

  // ---- Sale info (populated when status becomes SOLD) ----
  soldToName  String?
  soldToPhone String?
  soldToEmail String?
  soldPrice   Float?
  soldAt      DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  wishlist         Wishlist[]
  VehicleInquiry   VehicleInquiry[]
  fieldInspections FieldInspection[]
  purchaseRequests PurchaseRequest[]

  @@index([sellerId])
  @@index([status])
}

model VehicleInquiry {
  id               String         @id @default(uuid())
  vehicleListingId String
  vehicleListing   VehicleListing @relation(fields: [vehicleListingId], references: [id], onDelete: Cascade)
  buyerName        String
  buyerContact     String?
  buyerUserId      String?
  status           String         @default("INTERESTED") // INTERESTED | PURCHASED | LOST_INTEREST
  createdAt        DateTime       @default(now())

  @@index([vehicleListingId])
}

// ==========================================
// 🏢 CORE SERVICE PROVIDERS & INVENTORY
// ==========================================

model Garage {
  id        String          @id @default(uuid())
  name      String
  address   String
  city      String
  latitude  Float
  longitude Float
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  services  GarageService[]
  bookings  Booking[]
}

model MainService {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sections  ServiceSection[]
}

model ServiceSection {
  id            String      @id @default(uuid())
  name          String
  mainServiceId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  mainService   MainService @relation(fields: [mainServiceId], references: [id], onDelete: Cascade)
  services      Service[]
}

model Service {
  id            String          @id @default(uuid())
  name          String
  vehicleTypeId String
  sectionId     String
  description   String?
  price         Float
  originalPrice Float?
  discountType  DiscountType?
  discountValue Float?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  vehicleType   VehicleType     @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  section       ServiceSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  garages       GarageService[]
  bookings      Booking[]

  @@index([vehicleTypeId])
  @@index([sectionId])
}

model GarageService {
  id        String                 @id @default(uuid())
  garageId  String
  serviceId String
  garage    Garage                 @relation(fields: [garageId], references: [id], onDelete: Cascade)
  service   Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pricing   GarageServicePricing[]

  @@unique([garageId, serviceId])
  @@index([serviceId])
  @@index([garageId])
}

// ==========================================
// 🏷️ MARKETPLACE EXTENSIONS & INTERNALS
// ==========================================

model MarketplaceService {
  id                Int                        @id @default(autoincrement())
  externalServiceId String                     @unique
  name              String
  description       String?
  image             String?
  garageServices    GarageMarketplaceService[]
  packageItems      MarketplacePackageItem[]
  bookings          MarketplaceBooking[]
}

model GarageMarketplaceService {
  id          Int                    @id @default(autoincrement())
  userId      Int
  serviceId   Int
  isActive    Boolean                @default(false)
  duration    Int?
  description String?
  image       String?
  service     MarketplaceService     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pricing     GarageServicePricing[]

  @@unique([userId, serviceId])
  @@index([serviceId])
}

model GarageServicePricing {
  id                         Int                       @id @default(autoincrement())
  garageUserId               Int                       @map("garage_user_id")
  externalServiceId          String                    @map("external_service_id")
  carType                    String                    @map("car_type")
  price                      Float                     @default(0)
  discount                   Float                     @default(0)
  description                String?
  image                      String?
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  garageServiceId            String?
  garageMarketplaceServiceId Int?
  GarageService              GarageService?            @relation(fields: [garageServiceId], references: [id], onDelete: Cascade)
  GarageMarketplaceService   GarageMarketplaceService? @relation(fields: [garageMarketplaceServiceId], references: [id], onDelete: Cascade)

  @@unique([garageUserId, externalServiceId, carType])
  @@index([externalServiceId])
  @@index([garageUserId])
}

model GarageServiceMeta {
  id                Int      @id @default(autoincrement())
  garageUserId      Int      @map("garage_user_id")
  externalServiceId String   @map("external_service_id")
  description       String?
  image             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([garageUserId, externalServiceId])
  @@index([garageUserId])
  @@index([externalServiceId])
}

// ==========================================
// 📅 TRANSACTIONS & BOOKINGS
// ==========================================

model Booking {
  id          String        @id @default(uuid())
  userId      String
  garageId    String
  serviceId   String
  vehicleId   String
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  garage      Garage        @relation(fields: [garageId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  payments    Payment[]

  @@index([userId])
  @@index([garageId])
  @@index([serviceId])
}

model MarketplaceBooking {
  id          Int                @id @default(autoincrement())
  serviceId   Int
  garageId    Int
  clientId    Int
  status      BookingStatus      @default(PENDING)
  scheduledAt DateTime
  carType     String?
  finalPrice  Float
  service     MarketplaceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([garageId])
}

model MarketplacePackage {
  id        Int                      @id @default(autoincrement())
  userId    Int
  name      String
  price     Float
  isActive  Boolean                  @default(true)
  createdAt DateTime                 @default(now())
  items     MarketplacePackageItem[]

  @@index([userId])
}

model MarketplacePackageItem {
  id                 Int                @id @default(autoincrement())
  packageId          Int
  serviceId          Int
  serviceName        String
  basePrice          Float              @default(0)
  package            MarketplacePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  marketplaceService MarketplaceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([serviceId])
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String
  amount    Float
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ==========================================
// ⚙️ ENUMS
// ==========================================

enum Role {
  USER
  SELLER
  DEALER
  ADMIN
  BUYER
  FIELD_INSPECTOR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum VehicleSegment {
  HATCHBACK
  SEDAN
  SUV
  LUXURY
  SUPER_LUXURY
  PICKUP
  VAN
}

enum InspectionStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  RE_VERIFICATION
  COMPLETED
  REJECTED
}

enum InspectionResult {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CORRECTION
}

enum InspectionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  NEEDS_CORRECTION
}

enum ConditionStatus {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  MISSING
  EXPIRED
  MISMATCH
}

model FieldInspection {
  id           String @id @default(uuid())
  inspectionNo String @unique @default(cuid())

  vehicleListingId String
  vehicleListing   VehicleListing @relation(fields: [vehicleListingId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerInspections", fields: [sellerId], references: [id])

  inspectorId String
  inspector   User   @relation("InspectorInspections", fields: [inspectorId], references: [id])

  assignedById String?
  assignedBy   User?   @relation("AdminAssignedInspections", fields: [assignedById], references: [id])

  status   InspectionStatus   @default(ASSIGNED)
  result   InspectionResult   @default(PENDING)
  priority InspectionPriority @default(MEDIUM)

  assignedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  scheduledDate DateTime?
  deadline      DateTime?

  finalRating      Int?
  finalNotes       String?
  rejectionReason  String?
  correctionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist     InspectionChecklist?
  documents     InspectionDocumentVerification[]
  vehicleChecks InspectionVehicleCheck[]
  photos        InspectionPhoto[]
  location      InspectionLocation?

  @@index([inspectorId])
  @@index([sellerId])
  @@index([vehicleListingId])
  @@index([status])
}

model InspectionChecklist {
  id String @id @default(uuid())

  inspectionId String          @unique
  inspection   FieldInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  sellerVerified          Boolean @default(false)
  documentsVerified       Boolean @default(false)
  vehicleIdentityVerified Boolean @default(false)
  exteriorVerified        Boolean @default(false)
  interiorVerified        Boolean @default(false)
  mechanicalVerified      Boolean @default(false)
  testDriveCompleted      Boolean @default(false)
  locationVerified        Boolean @default(false)
  photosCompleted         Boolean @default(false)

  sellerNotes     String?
  documentNotes   String?
  identityNotes   String?
  exteriorNotes   String?
  interiorNotes   String?
  mechanicalNotes String?
  testDriveNotes  String?
  locationNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InspectionDocumentVerification {
  id              String                     @id @default(uuid())
  inspectionId    String
  inspection      FieldInspection            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  documentType    String
  documentUrl     String?
  documentNumber  String?
  status          DocumentVerificationStatus @default(PENDING)
  remarks         String?
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([inspectionId, documentType])
  @@index([inspectionId])
}

model InspectionVehicleCheck {
  id String @id @default(uuid())

  inspectionId String
  inspection   FieldInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  category String // e.g. "Exterior", "Interior", "Mechanical"
  item     String // e.g. "Front Bumper", "AC", "Brakes"

  condition ConditionStatus?
  status    VerificationStatus @default(PENDING)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inspectionId])
}

model InspectionPhoto {
  id String @id @default(uuid())

  inspectionId String
  inspection   FieldInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  category String
  imageUrl String

  latitude  Float?
  longitude Float?

  capturedAt DateTime?
  uploadedAt DateTime  @default(now())

  remarks String?

  @@index([inspectionId])
}

model InspectionLocation {
  id String @id @default(uuid())

  inspectionId String          @unique
  inspection   FieldInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  expectedAddress   String?
  expectedLatitude  Float?
  expectedLongitude Float?

  actualAddress   String?
  actualLatitude  Float?
  actualLongitude Float?

  locationMatched Boolean @default(false)
  vehiclePresent  Boolean @default(false)
  sellerPresent   Boolean @default(false)

  remarks String?

  capturedAt DateTime?
}

model InspectionNotification {
  id           String  @id @default(uuid())
  userId       String
  user         User    @relation("InspectionNotifications", fields: [userId], references: [id], onDelete: Cascade)
  inspectionId String?

  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

// =============Buyer Purchase Inquiry (Request to Seller)====================

enum PurchaseRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model PurchaseRequest {
  id               String         @id @default(uuid())
  vehicleListingId String
  vehicleListing   VehicleListing @relation(fields: [vehicleListingId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerPurchaseRequests", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerPurchaseRequests", fields: [sellerId], references: [id], onDelete: Cascade)

  offerPrice Float
  buyerName  String
  buyerPhone String
  buyerEmail String?
  message    String?

  status       PurchaseRequestStatus @default(PENDING)
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleListingId])
